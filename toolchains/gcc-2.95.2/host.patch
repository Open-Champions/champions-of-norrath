diff --git a/gcc/expr.h b/gcc/expr.h
index 55e82e6..f14c1bd 100644
--- a/gcc/expr.h
+++ b/gcc/expr.h
@@ -374,7 +374,15 @@ typedef struct optab
 #define GEN_FCN(CODE) (*insn_gen_function[(int) (CODE)])
 #endif
 
-extern rtx (*const insn_gen_function[]) PROTO ((rtx, ...));
+/* Host-only compatibility: generated callees have fixed arguments.
+   Apple ARM64 distinguishes variadic from fixed-argument call placement.
+   Match the unprototyped table definition emitted by genoutput.c. */
+#if defined(__APPLE__) && defined(__aarch64__)
+#define INSN_GEN_PROTO ()
+#else
+#define INSN_GEN_PROTO PROTO ((rtx, ...))
+#endif
+extern rtx (*const insn_gen_function[]) INSN_GEN_PROTO;
 
 extern optab add_optab;
 extern optab sub_optab;

diff --git a/config.sub b/config.sub
index 567459e..f7e9990 100755
--- a/config.sub
+++ b/config.sub
@@ -1,4 +1,6 @@
 #! /bin/sh
+# Local host-only compatibility: native Apple Silicon cross-compiler host.
+case "$1" in aarch64-apple-darwin*) echo "$1"; exit 0 ;; esac
 # Configuration validation subroutine script, version 1.1.
 #   Copyright (C) 1991, 92-97, 1998, 1999 Free Software Foundation, Inc.
 # This file is (in principle) common to ALL GNU software.
diff --git a/gcc/configure b/gcc/configure
index cc73760..1d40c92 100755
--- a/gcc/configure
+++ b/gcc/configure
@@ -2972,6 +2972,16 @@ for machine in $build $host $target; do
 	esac
 
 	case $machine in
+	aarch64-apple-darwin*)
+                # Host only: the target remains the upstream MIPS configuration.
+                if test "$machine" = "$target"; then
+                    echo "Native Darwin target is not implemented" >&2
+                    exit 1
+                fi
+                xm_file=xm-aarch64-darwin.h
+                xm_defines="HAVE_ATEXIT POSIX"
+                xmake_file=
+                ;;
 	# Support site-specific machine types.
 	*local*)
 		cpu_type=`echo $machine | sed -e 's/-.*//'`

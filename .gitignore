# Only authored metadata and intake tools are allowed; private inputs stay ignored.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/AGENTS.md
!/CONTRIBUTING.md
!/LICENSE
!/docs/
/docs/*
!/docs/*.md
!/docs/agents/
/docs/agents/*
!/docs/agents/*.md
!/host-tests/
/host-tests/*
!/host-tests/save-net-anim/
/host-tests/save-net-anim/*
!/host-tests/save-net-anim/*.py
!/host-tests/save-net-anim/*.cpp
!/host-tests/card-progress/
/host-tests/card-progress/*
!/host-tests/card-progress/*.py
!/targets/
/targets/*
!/targets/README.md
!/targets/SLUS-20565/
/targets/SLUS-20565/*
!/targets/SLUS-20565/*.json
!/reconstructed/
/reconstructed/*
!/reconstructed/*.cpp
!/experimental/
/experimental/**
!/experimental/README.md
!/experimental/snapshot.json
!/experimental/build-plan.json
!/experimental/build-receipt.json
!/experimental/build-receipt-expanded.json
!/experimental/startup-newlib-receipt.json
!/experimental/startup-initsys-receipt.json
!/experimental/sources/
!/experimental/sources/**/
!/experimental/sources/**/*.cpp
!/experimental/sources/**/*.hpp
!/experimental/sources/**/*.S
# This one independently authored transport draft retains its compile hold.
!/experimental/sources/game-amx-exec-native-transport-source-v4/transport.S
!/tools/
/tools/*
!/tools/*.py
!/tools/checks/
!/tools/checks/*.cpp
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/intake.yml
!/toolchains/
/toolchains/*
!/toolchains/gcc-2.95.2/
/toolchains/gcc-2.95.2/*
!/toolchains/gcc-2.95.2/README.md
!/toolchains/gcc-2.95.2/COPYING
!/toolchains/gcc-2.95.2/host.patch
!/toolchains/gcc-2.95.2/xm-aarch64-darwin.h

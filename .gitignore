# Only authored metadata and intake tools are allowed; private inputs stay ignored.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/AGENTS.md
!/CONTRIBUTING.md
!/LICENSE
!/docs/
/docs/*
!/docs/*.md
!/targets/
/targets/*
!/targets/README.md
!/targets/SLUS-20565/
/targets/SLUS-20565/*
!/targets/SLUS-20565/*.json
!/reconstructed/
/reconstructed/*
!/reconstructed/*.cpp
!/tools/
/tools/*
!/tools/*.py
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/intake.yml

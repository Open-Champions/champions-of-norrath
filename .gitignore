# Only authored metadata and intake tools are allowed; private inputs stay ignored.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/AGENTS.md
!/CONTRIBUTING.md
!/LICENSE
!/docs/
/docs/*
!/docs/*.md
!/targets/
/targets/*
!/targets/README.md
!/targets/SLUS-20565/
/targets/SLUS-20565/*
!/targets/SLUS-20565/*.json
!/reconstructed/
/reconstructed/*
!/reconstructed/*.cpp
!/tools/
/tools/*
!/tools/*.py
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/intake.yml
!/toolchains/
/toolchains/*
!/toolchains/gcc-2.95.2/
/toolchains/gcc-2.95.2/*
!/toolchains/gcc-2.95.2/README.md
!/toolchains/gcc-2.95.2/COPYING
!/toolchains/gcc-2.95.2/host.patch
!/toolchains/gcc-2.95.2/xm-aarch64-darwin.h
!/toolchains/gcc-2.95.2/profile.json
!/toolchains/gcc-2.95.2/build.json
